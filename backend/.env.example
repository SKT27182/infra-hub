# =============================================================================
# Infra Hub - Environment Configuration (template)
# =============================================================================
# Copy to .env and set values. DO NOT commit .env to version control.
#
# Local convention (easy to remember): username/id = admin, password = password123
# Exception: Neo4j requires the built-in user name `neo4j` (password still from env).
# All values below are loaded via env / config — nothing is hardcoded in app code.
#
# Docker Compose reads this file for ports and credentials:
#   docker compose --env-file backend/.env up -d
#   make up   # passes --env-file automatically
#
# Port naming:
#   *_PORT              = host port (what apps/browser use on your machine)
#   *_INTERNAL_PORT     = container listen port (commands, healthchecks, mapping target)
#
# Persistent service data (Postgres/Redis/MinIO/…) is stored outside the repo.
# Override with another absolute path when needed.
INFRA_PERSIST_DIR=${HOME}/.local/share/projects/infra-hub/volumes

API_PORT=8888
API_HOST=127.0.0.1
HOST_ONLY_MODE=true
SERVICE_PUBLIC_HOST=127.0.0.1
SERVICE_BIND_HOST=127.0.0.1
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=password123
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://127.0.0.1:5143,http://localhost:5143

# Optional app / logging (backend only)
APP_PUBLIC_URL=http://127.0.0.1:5143
APP_PUBLIC_HOST=127.0.0.1
LOG_LEVEL=INFO
# Dev logs outside the repository.
LOG_PATH=${HOME}/.local/share/projects/infra-hub/dev-logs

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=main_db
POSTGRES_PORT=54321
POSTGRES_INTERNAL_PORT=5432

# =============================================================================
# pgAdmin (email is required by pgAdmin; password matches local convention)
# =============================================================================
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=password123
PGADMIN_PORT=5050
PGADMIN_INTERNAL_PORT=80

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=password123
REDIS_PORT=63791
REDIS_INTERNAL_PORT=6379
REDISINSIGHT_PORT=5540
REDISINSIGHT_INTERNAL_PORT=5540

# =============================================================================
# MongoDB
# =============================================================================
MONGO_USER=admin
MONGO_PASSWORD=password123
MONGODB_PORT=27018
MONGODB_INTERNAL_PORT=27017

# =============================================================================
# Mongo Express (Web UI)
# =============================================================================
ME_USER=admin
ME_PASSWORD=password123
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_INTERNAL_PORT=8081

# =============================================================================
# Qdrant (leave QDRANT_API_KEY empty to disable dashboard/API auth)
# =============================================================================
QDRANT_API_KEY=password123
QDRANT_REST_PORT=6333
QDRANT_REST_INTERNAL_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_GRPC_INTERNAL_PORT=6334

# =============================================================================
# MinIO (password must be at least 8 characters)
# =============================================================================
MINIO_USER=admin
MINIO_PASSWORD=password123
MINIO_PORT=9000
MINIO_INTERNAL_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_INTERNAL_CONSOLE_PORT=9001

# =============================================================================
# Neo4j (username must remain neo4j for Community Edition)
# =============================================================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_HTTP_PORT=7474
NEO4J_HTTP_INTERNAL_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_BOLT_INTERNAL_PORT=7687

# =============================================================================
# OpenSearch (local single-node; security plugin disabled)
# Linux hosts may need: sudo sysctl -w vm.max_map_count=262144
# =============================================================================
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_HTTP_INTERNAL_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_DASHBOARDS_INTERNAL_PORT=5601
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"
